# Public site origin — used for sitemap, robots, OG images, JSON-LD canonical URLs.
# IMPORTANT: include the protocol; no trailing slash.
# On Vercel production, https://www.taban-niroo.com is used automatically if unset.
NEXT_PUBLIC_SITE_URL=https://www.taban-niroo.com

# Google Search Console HTML-tag verification (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Required for production contact form ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Override destination inbox (defaults to info@taban-niroo.com)
CONTACT_TO_EMAIL=

# --- Newsletter (optional; form stays hidden until both are set) ---
# Create an Audience in Resend, paste its id, then set the public flag:
RESEND_AUDIENCE_ID=
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# --- Required for durable rate limiting on Vercel ---
# Create a free Redis DB at https://upstash.com and paste REST credentials:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Full-site admin CMS (/admin — Persian panel) ---
# Username defaults to "admin" if unset.
CMS_ADMIN_USERNAME=admin
# Password for the client to sign in (pick a long random string).
CMS_ADMIN_PASSWORD=
# Optional dedicated HMAC secret for session cookies (min 16 chars).
# Required for production readiness (see npm run check-env).
# If unset locally, a key is derived from CMS_ADMIN_PASSWORD.
CMS_SESSION_SECRET=
# Bump to force-revoke all CMS sessions without changing the password.
CMS_SESSION_VERSION=1
# Optional shared key for server-to-server CMS calls (header: x-cms-internal).
CMS_INTERNAL_KEY=
# Vercel Blob token — Storage → Create Blob Store → copy BLOB_READ_WRITE_TOKEN.
# Required on Vercel so products, content, blog, gallery, and uploads persist.
# Locally, manifests fall back to data/ and files to public/uploads/cms.
BLOB_READ_WRITE_TOKEN=

# --- Optional error monitoring (Sentry / @sentry/nextjs) ---
# Create a project at https://sentry.io → Settings → Client Keys (DSN).
# Server + edge use SENTRY_DSN; browser uses NEXT_PUBLIC_SENTRY_DSN
# (you can paste the same DSN in both). Without these, reporting is a no-op.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload source maps on `next build` (CI / Vercel).
# Create an auth token with project:releases + org:read at sentry.io.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Before deploy ---
# npm run check-env:strict
# Confirm GET /api/health → { "status": "ok" }

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked)
.env
.env.*
!.env.example

# vercel
.vercel

# local gallery CMS (dev filesystem fallback)
/data/gallery-manifest.json
/public/uploads/

# large source assets (not shipped; re-encode before replacing public/videos)
/assets-raw/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# lighthouse lab reports
/.lighthouse/
# macOS
.DS_Store

# local debug screenshots
.tmp-*.png
